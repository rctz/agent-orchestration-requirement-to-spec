{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "req3/question.schema.json",
  "title": "req3 question object (design §5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "text", "kind", "default_answer"],
  "properties": {
    "id": {"type": "string", "pattern": "^Q-\\d{2}$"},
    "text": {"type": "string", "minLength": 1},
    "why": {"type": "string"},
    "kind": {"enum": ["choice", "free_text", "confirm"]},
    "options": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "default_answer": {"type": "string", "minLength": 1},
    "default_rationale": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "choice"}}},
      "then": {"required": ["options"]}
    }
  ]
}
